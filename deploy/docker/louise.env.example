# deploy/docker/louise.env.example — copy to deploy/docker/.env and edit.
# Identity and wiring only (CLAUDE.md invariant 10: env = identity). What
# the node holds and does is desired state: config/platform.toml and
# config/collections/*.toml, inside the config volume.

# The compose project: a second node on the same host takes another name
# (and other ports) — its volumes are its own.
LOUISE_PROJECT=louise
LOUISE_IMAGE=louise-rag:local

# Ports on this host: the web (Ask, the Library, the peer messages under
# /api/share/) and the swarm (members by torrent, tcp and udp).
LOUISE_HTTP_PORT=8742
LOUISE_PEER_PORT=6881

# Where peers reach THIS node, seeded into platform.toml once, on first boot
# (app/node_init.py). Use an address other machines can reach: the LAN IP or
# a DNS name of this host, with LOUISE_HTTP_PORT. Empty: set it in
# platform.toml [node] address later.
LOUISE_NODE_ADDRESS=

# Storage. Named volumes by default (see compose.yaml, STORAGE). A host path
# here makes a bind mount — on a Linux host's local disk only.
# LOUISE_DATA=louise-data
# LOUISE_CONFIG=louise-config
# LOUISE_CORPORA=/srv/louise/corpora
# LOUISE_EXPORTS=/srv/louise/exports

# Model endpoints (invariant 7: the app runs no model). Each collection names
# its encoder in its own file; these are the chat, translation and rerank
# services.
CHAT_URL=
CHAT_API=openai
CHAT_MODEL=
TRANSLATE_URL=
TRANSLATE_MODEL=
RERANK_URL=
# where an api = "vega" encoder's receipts are read (docs/notes/vega.md)
VEGA_URL=

# Linux with a GPU: `--profile gpu` and
# GPU_PROBE_URL=http://gpu-probe:8080

# Set by up.sh from the image it built (07 §7.3: the platform a Codex names).
# LOUISE_PLATFORM_IMAGE=
