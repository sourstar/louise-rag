From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 28 Oct 2026 10:37:41 +0000
Subject: [PATCH] fix(llama-cpp): the SYCL batched F16 matmul reads a
 non-contiguous src1 right without oneDNN

Carried as a llama.cpp patch beside the others
(patches/0005-sycl-batched-mul-mat-src1-strides.patch). ggml-sycl's
ggml_sycl_mul_mat_batched_sycl, in a build with oneDNN compiled in, made a
flat copy of src1 and then, when the oneMKL GEMM ran instead of oneDNN's
(GGML_SYCL_ENABLE_DNN=0, the bit-reproducible mode; or no optimized oneDNN
GEMM for the device), read it with contiguous strides. The KQ product of a
decoder step with two or more tokens over an F16 K cache read the wrong
queries: on the Intel Arc Pro B70 a T5 (MADLAD-400) decoding several slots
in one batch produced wrong text, alone it was right, and test-backend-ops
failed its 32 strided F16xF32 cases with ne13 > 1 (on compute-runtime 26.27
and 26.35 alike). The conversion now matches the GEMM that runs; the patch
adds the decoder KQ shapes to test-backend-ops.

Assisted-by: Claude Code
---
 ...05-sycl-batched-mul-mat-src1-strides.patch | 122 ++++++++++++++++++
 1 file changed, 122 insertions(+)
 create mode 100644 backend/cpp/llama-cpp/patches/0005-sycl-batched-mul-mat-src1-strides.patch

diff --git a/backend/cpp/llama-cpp/patches/0005-sycl-batched-mul-mat-src1-strides.patch b/backend/cpp/llama-cpp/patches/0005-sycl-batched-mul-mat-src1-strides.patch
new file mode 100644
index 00000000..16552bf9
--- /dev/null
+++ b/backend/cpp/llama-cpp/patches/0005-sycl-batched-mul-mat-src1-strides.patch
@@ -0,0 +1,122 @@
+sycl: convert a non-contiguous src1 for the GEMM that will run (batched F16 mul_mat)
+
+ggml_sycl_mul_mat_batched_sycl (F16 src0, F32 src1: the KQ product over an
+F16 K cache, the KQV product over an F16 V cache) converts src1 to F16
+before the GEMM. A build with oneDNN (GGML_SYCL_DNNL) made a flat copy of
+src1's whole extent - right for the oneDNN GEMM, which reads src1's own
+strides - and then set s11/s12/s13 to the CONTIGUOUS strides and
+is_src1_cont_2 = true whichever GEMM ran. With oneDNN disabled at run time
+(GGML_SYCL_ENABLE_DNN=0, needed for bit-reproducible results) or no
+optimized oneDNN GEMM for the device, the oneMKL gemm_batch calls read the
+flat copy as contiguous: wrong data for every non-contiguous src1 - the
+permuted queries of a decoder step with two or more tokens (a T5 decoding
+several sequences in one batch produced wrong text on an Intel Arc Pro B70;
+one sequence alone takes mul_mat_vec_p021 and is right; an F32 K cache
+takes another path and is right), and test-backend-ops' strided F16xF32
+views whenever ne13 > 1 (32 FAIL on the B70 at c0fd786, on compute-runtime
+26.27 and 26.35 alike).
+
+The choice of GEMM is now made once, before the conversion: the flat copy
+only when the oneDNN GEMM will run (src1's strides stay as they are), the
+gather (to_fp16_nc_sycl) with the contiguous strides otherwise. Since
+bdca38376 (sycl: Hotfix for non dnnl codepath, #14677, 2025-07-14) for a
+oneDNN build with GGML_SYCL_DISABLE_DNN=1 / GGML_SYCL_ENABLE_DNN=0, and
+since the has_optimized_gemm gate for devices without one.
+
+test-backend-ops: the decoder KQ shape (F16 a and F32 b permuted
+[0, 2, 1, 3], 16 heads, n = 2, 4, 7). The suite's permuted F16xF32 cases
+all had n = 1, where the permuted b's layout is the contiguous one.
+
+diff --git a/ggml/src/ggml-sycl/ggml-sycl.cpp b/ggml/src/ggml-sycl/ggml-sycl.cpp
+index b380cbedf..6ef8566ea 100644
+--- a/ggml/src/ggml-sycl/ggml-sycl.cpp
++++ b/ggml/src/ggml-sycl/ggml-sycl.cpp
+@@ -4014,12 +4014,24 @@ static void ggml_sycl_mul_mat_batched_sycl(ggml_backend_sycl_context & ctx, cons
+     int64_t                          s13 = nb13 / type_size_src1;
+     ggml_sycl_pool_alloc<sycl::half> src1_f16_alloc(ctx.pool());
+ 
++    // Which GEMM runs below decides how src1 is converted: oneDNN reads src1's own
++    // strides, so a flat copy of its whole extent is enough; oneMKL gets a
++    // contiguous src1, so a non-contiguous src1 (a permuted q in the KQ product
++    // of several tokens, a strided view) has to be gathered. Deciding here, once,
++    // keeps the copy and the strides handed to the GEMM consistent: a oneDNN
++    // build running oneMKL (GGML_SYCL_ENABLE_DNN=0, or no optimized oneDNN GEMM
++    // for the device) used to flat-copy src1 and then read it as contiguous.
++#if GGML_SYCL_DNNL
++    const bool use_dnnl_gemm = g_ggml_sycl_enable_dnn && ggml_sycl_dnnl_has_optimized_gemm(ggml_sycl_get_device());
++#endif
++
+     // convert src1 to fp16
+     if (src1->type != GGML_TYPE_F16) {
+         scope_op_debug_print    scope_dbg_print(__func__, "/to_fp16_nc_sycl", dst, /*num_src=*/2,
+                                                 " : converting src1 to fp16");
+ 
+ #if GGML_SYCL_DNNL
++        if (use_dnnl_gemm) {
+         // iterate tensor dims and find the slowest moving dim and stride
+         int last_dim=0;
+         int last_str=0;
+@@ -4039,19 +4051,24 @@ static void ggml_sycl_mul_mat_batched_sycl(ggml_backend_sycl_context & ctx, cons
+             }
+ 
+         }
+-        // oneDNN handles strided data and does not need overhead of ggml_get_to_fp16_nc_sycl
++        // oneDNN handles strided data and does not need overhead of ggml_get_to_fp16_nc_sycl:
++        // a flat copy of src1's whole extent keeps its layout, and the oneDNN GEMM below
++        // reads it with src1's own strides (nb1x); s11/s12/s13 and is_src1_cont_2 stay as they are
+         const int64_t ne_src1 = src1->nb[last_str] * src1->ne[last_dim] / type_size_src1;
+         src1_f16_alloc.alloc(ne_src1);
+         const to_fp16_sycl_t to_fp16_sycl = ggml_get_to_fp16_sycl(src1->type, dst);
+         GGML_ASSERT(to_fp16_sycl != nullptr);
+         to_fp16_sycl(src1_f16, src1_f16_alloc.get(), ne_src1, queue);
+-# else
++        src1_f16 = src1_f16_alloc.get();
++        } else
++#endif
++        {
++        // the oneMKL GEMMs below take a contiguous src1: gather it
+         const int64_t ne_src1 = ggml_nelements(src1);
+         src1_f16_alloc.alloc(ne_src1);
+         const to_fp16_nc_sycl_t to_fp16_nc_sycl = ggml_get_to_fp16_nc_sycl(src1->type);
+         GGML_ASSERT(to_fp16_nc_sycl != nullptr);
+         to_fp16_nc_sycl(src1_f16, src1_f16_alloc.get(), ne10, ne11, ne12, ne13, s11, s12, s13, queue);
+-#endif
+ 
+         src1_f16 = src1_f16_alloc.get();
+         s11      = ne10;
+@@ -4059,6 +4076,7 @@ static void ggml_sycl_mul_mat_batched_sycl(ggml_backend_sycl_context & ctx, cons
+         s13      = ne12 * s12;
+ 
+         is_src1_cont_2 = true;
++        }
+     }
+ 
+     ggml_sycl_pool_alloc<sycl::half> dst_f16(ctx.pool());
+@@ -4086,7 +4104,7 @@ static void ggml_sycl_mul_mat_batched_sycl(ggml_backend_sycl_context & ctx, cons
+     const int64_t r3 = ne13 / ne03;
+ 
+ #if GGML_SYCL_DNNL
+-    if (g_ggml_sycl_enable_dnn && ggml_sycl_dnnl_has_optimized_gemm(ggml_sycl_get_device())) {
++    if (use_dnnl_gemm) {
+             int64_t str_a0 = nb00 / type_size_src0;
+             int64_t str_a1 = nb01 / type_size_src0;
+             int64_t str_a2 = nb02 / type_size_src0;
+diff --git a/tests/test-backend-ops.cpp b/tests/test-backend-ops.cpp
+index 8826b274b..20a93691b 100644
+--- a/tests/test-backend-ops.cpp
++++ b/tests/test-backend-ops.cpp
+@@ -11010,6 +11010,14 @@ static std::vector<std::unique_ptr<test_case>> make_test_cases_eval() {
+     }
+ #endif
+ 
++    // the KQ product of a decoder step with several tokens: the F16 K cache view and the F32
++    // queries, both permuted [0, 2, 1, 3], one head per batch (a non-contiguous F32 src1 for the
++    // F16 batched path; the cases above with a permuted src1 all have n = 1, where its layout
++    // happens to be the contiguous one)
++    for (int64_t n : {2, 4, 7}) {
++        test_cases.emplace_back(new test_mul_mat(GGML_TYPE_F16, GGML_TYPE_F32, 64, n, 128, {16, 1}, {1, 1}, {0, 2, 1, 3}));
++    }
++
+     for (auto bs2 : {1,3}) {
+         for (auto bs : {1,2,4,8}) {
+             for (auto nr : {1,4}) {
-- 
2.43.0

