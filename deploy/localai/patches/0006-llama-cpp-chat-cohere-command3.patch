From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 3 Nov 2026 18:29:47 +0000
Subject: [PATCH] fix(llama-cpp): parse Command R7B / Command A tool calls
 (Command 3 format)

Carried as a llama.cpp patch beside the others
(patches/0008-chat-cohere-command3-parser.patch). At llama.cpp ddf48f8 a
Command R7B tool call came back as HTTP 500 ("rpc error: code = Unknown desc
= Unexpected error in RPC handling"): the autoparser preserves
"<|START_THINKING|><|END_THINKING|><|START_ACTION|>" as one token string,
which matches no token, so the three markers are dropped from the generated
text and the final parse throws; and Cohere's tool templates end every
prompt with the generation prompt, so none is derived. The patch parses
Command 3 templates with llama.cpp's own Cohere2 MoE parser, which Cohere's
parser library (cohere-ai/melody, cmd3/cmd4) shows to be the same format
with <|START_RESPONSE|> for <|START_TEXT|>, and adds tests: the original R7B
templates, melody's cmd3 vectors, the preserved tokens.

Assisted-by: Claude Code
---
 .../0008-chat-cohere-command3-parser.patch    | 623 ++++++++++++++++++
 1 file changed, 623 insertions(+)
 create mode 100755 backend/cpp/llama-cpp/patches/0008-chat-cohere-command3-parser.patch

diff --git a/backend/cpp/llama-cpp/patches/0008-chat-cohere-command3-parser.patch b/backend/cpp/llama-cpp/patches/0008-chat-cohere-command3-parser.patch
new file mode 100755
index 0000000..9fb9804
--- /dev/null
+++ b/backend/cpp/llama-cpp/patches/0008-chat-cohere-command3-parser.patch
@@ -0,0 +1,623 @@
+chat: parse Command R7B / Command A ("Command 3") with the Cohere2 MoE parser
+
+Command R7B's tool calls failed with HTTP 500 ("The model produced output
+that does not match the expected peg-native format"). The autoparser derives
+"<|START_THINKING|><|END_THINKING|><|START_ACTION|>" as ONE preserved token;
+no single token matches it, so the server drops those three control tokens
+from the output and the parser sees "...plan.[{...}]". Its tool templates
+also end every prompt with <|START_OF_TURN_TOKEN|><|CHATBOT_TOKEN|> whether
+a generation prompt is asked for or not, so no generation prompt is derived
+(the first streamed token fails).
+
+Cohere's own parser library defines Command 3 as Command 4 (the Cohere2 MoE /
+North format) with <|START_RESPONSE|>/<|END_RESPONSE|> instead of
+<|START_TEXT|>/<|END_TEXT|> and a thinking block the model opens itself
+(cohere-ai/melody, MIT, FilterOptions::cmd3 and ::cmd4; vLLM's Cohere parser
+uses it). So the existing cohere2moe parser takes Command 3 templates too:
+the content markers follow the template, every Cohere marker is preserved,
+the generation prompt falls back to the prompt's tail, and the opening
+<|START_THINKING|> is atomic so a marker still arriving is not streamed as
+content (reasoning_format=none).
+
+Tests: Cohere's original R7B templates as the GGUFs carry them (default and
+tool_use), melody's cmd3 vectors (a plan then a call, a call without a plan,
+a non-ASCII argument, two calls in one action), an answer with tools offered,
+and the preserved tokens and generation prompt, which a text-fed parser test
+cannot see. Upstream's R7B and Cohere2 MoE cases pass unchanged.
+
+diff --git a/common/chat.cpp b/common/chat.cpp
+index 5f956e6..676c128 100644
+--- a/common/chat.cpp
++++ b/common/chat.cpp
+@@ -1341,6 +1341,18 @@ static common_chat_params_init_fn common_chat_template_detect_params_init(const
+         return common_chat_params_init_cohere2moe;
+     }
+ 
++    // Command R7B / Command A ("Command 3") - the same format with <|START_RESPONSE|> content, and the
++    // same parser. The autoparser derives "<|START_THINKING|><|END_THINKING|><|START_ACTION|>" as ONE
++    // preserved token, which no single token matches, so the server drops those three control tokens
++    // from the output and the tool call cannot be parsed (HTTP 500); and the tool templates end every
++    // prompt with the generation prompt, so it derives none.
++    if (src.find("<|START_RESPONSE|>") != std::string::npos &&
++        src.find("<|START_ACTION|>") != std::string::npos &&
++        src.find("<|CHATBOT_TOKEN|>") != std::string::npos) {
++        LOG_DBG("Using specialized template: Cohere Command 3\n");
++        return common_chat_params_init_cohere2moe;
++    }
++
+     if (is_lfm2_template(src)) {
+         LOG_DBG("Using specialized template: LFM2\n");
+         return common_chat_params_init_lfm2_tokens;
+diff --git a/common/parsers/cohere2moe.cpp b/common/parsers/cohere2moe.cpp
+index 40e851a..86c2a62 100644
+--- a/common/parsers/cohere2moe.cpp
++++ b/common/parsers/cohere2moe.cpp
+@@ -16,10 +16,21 @@
+ // parser literal therefore only covers the stable <|START_OF_TURN_TOKEN|><|CHATBOT_TOKEN|> prefix
+ // and the reasoning rule consumes the <|START_THINKING|> ... <|END_THINKING|> markers itself,
+ // regardless of whether they came from the generation prompt or the generated text.
++//
++// Command R7B and Command A ("Command 3") use the same format with <|START_RESPONSE|> /
++// <|END_RESPONSE|> around the content instead of <|START_TEXT|> / <|END_TEXT|>, and a thinking block
++// the model opens itself (optional here in both). Cohere's own parser library defines the two this way
++// (cohere-ai/melody, MIT: FilterOptions::cmd3 and ::cmd4; vLLM parses both through it).
++// Command 3's tool templates end every prompt with <|START_OF_TURN_TOKEN|><|CHATBOT_TOKEN|> whether a
++// generation prompt is asked for or not, so the two renderings do not differ there and the generation
++// prompt is taken from the prompt's tail. Its markers are control tokens: unless they are preserved,
++// the server drops them from the text and no parser can find the turn's structure.
+ common_chat_params common_chat_params_init_cohere2moe(const common_chat_template &          tmpl,
+                                                               const autoparser::generation_params & inputs) {
+     common_chat_params data;
+ 
++    const bool command3 = tmpl.source().find("<|START_TEXT|>") == std::string::npos;
++
+     const std::string TURN_START    = "<|START_OF_TURN_TOKEN|>";
+     const std::string TURN_END      = "<|END_OF_TURN_TOKEN|>";
+     const std::string CHATBOT       = "<|CHATBOT_TOKEN|>";
+@@ -27,8 +38,8 @@ common_chat_params common_chat_params_init_cohere2moe(const common_chat_template
+     const std::string SYSTEM        = "<|SYSTEM_TOKEN|>";
+     const std::string THINK_START   = "<|START_THINKING|>";
+     const std::string THINK_END     = "<|END_THINKING|>";
+-    const std::string TEXT_START    = "<|START_TEXT|>";
+-    const std::string TEXT_END      = "<|END_TEXT|>";
++    const std::string TEXT_START    = command3 ? "<|START_RESPONSE|>" : "<|START_TEXT|>";
++    const std::string TEXT_END      = command3 ? "<|END_RESPONSE|>" : "<|END_TEXT|>";
+     const std::string ACTION_START  = "<|START_ACTION|>";
+     const std::string ACTION_END    = "<|END_ACTION|>";
+     const std::string RESULT_START  = "<|START_TOOL_RESULT|>";
+@@ -39,6 +50,9 @@ common_chat_params common_chat_params_init_cohere2moe(const common_chat_template
+ 
+     data.prompt             = common_chat_template_direct_apply_impl(tmpl, inputs);
+     data.generation_prompt  = common_chat_template_generation_prompt_impl(tmpl, inputs);
++    if (data.generation_prompt.empty() && string_ends_with(data.prompt.str(), GEN_PREFIX)) {
++        data.generation_prompt = GEN_PREFIX;
++    }
+     data.format             = COMMON_CHAT_FORMAT_PEG_NATIVE;
+     data.supports_thinking  = true;
+     data.thinking_start_tag = THINK_START;
+@@ -81,7 +95,8 @@ common_chat_params common_chat_params_init_cohere2moe(const common_chat_template
+         auto generation_prompt = p.literal(GEN_PREFIX);
+         auto end               = p.end();
+ 
+-        // The thinking block is always present (the generation prompt forces <|START_THINKING|>).
++        // The thinking block is always present for Command 4 (the generation prompt forces
++        // <|START_THINKING|>) and written by the model, or skipped, for Command 3.
+         // When extracting reasoning, capture its body; otherwise keep the whole block (markers
+         // included) inline as content, matching reasoning_format=NONE conventions.
+         common_peg_parser reasoning = p.eps();
+@@ -90,8 +105,10 @@ common_chat_params common_chat_params_init_cohere2moe(const common_chat_template
+                                    p.reasoning(p.until_one_of({ THINK_END, TEXT_START, ACTION_START })) +
+                                    p.optional(p.literal(THINK_END)));
+         } else {
+-            reasoning = p.optional(p.content(p.literal(THINK_START) +
+-                                             p.until_one_of({ THINK_END, TEXT_START, ACTION_START }) +
++            // Atomic opening: a Command 3 model writes <|START_THINKING|> itself, and a marker still
++            // arriving must not be streamed as content (the same pattern as harmony-xml's analysis).
++            reasoning = p.optional(p.atomic(p.content(p.literal(THINK_START))) +
++                                   p.content(p.until_one_of({ THINK_END, TEXT_START, ACTION_START }) +
+                                              p.optional(p.literal(THINK_END))));
+         }
+ 
+diff --git a/models/templates/CohereForAI-c4ai-command-r7b-12-2024-default.jinja b/models/templates/CohereForAI-c4ai-command-r7b-12-2024-default.jinja
+new file mode 100644
+index 0000000..a4369b7
+--- /dev/null
++++ b/models/templates/CohereForAI-c4ai-command-r7b-12-2024-default.jinja
+@@ -0,0 +1,186 @@
