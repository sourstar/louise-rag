# The same sentence-transformers row as Dockerfile, but on the node's card.
#
# FROM the RAGE image, because it already carries the one thing that is hard
# to get right — torch 2.14.0+xpu against this driver — and its own
# Dockerfile records what that cost (`import torch` died on "undefined
# symbol: urDeviceWaitExp" until the layer order was fixed). Reproducing
# that here would be copying a solved problem badly.
#
# This is a SIDE-CAR, not a change to RAGE. It adds a venv to a derived
# image that is run once and thrown away; the deployed `ghcr.io/sourstar/rage`
# digest, the running app and its `rage.toml` are untouched. Serving
# DAR-legal-it properly — a server module, a `rage.d` entry, measured
# memory, a pushed image — is a separate decision, and this measurement is
# what should inform it rather than precede it.
#
# Expect the running models to be evicted from VRAM while this holds the
# card (KNOWN-ISSUES C6): the `xe` driver migrates idle allocations out
# rather than failing the new one, it recovers by itself, and the first
# production request afterwards pays ~0.49 s.
ARG RAGE_DIGEST=sha256:8ee29dfab3d7f8720cb48cb6b5367c1b17679475472cd615a69a77ce48e40489
FROM ghcr.io/sourstar/rage@${RAGE_DIGEST}

# --system-site-packages so the venv sees the system torch XPU rather than
# pulling a CPU wheel over it — the same pattern the RAGE image uses for its
# three server venvs. Pinned to what the model card says produced the
# published numbers this run is checked against.
RUN python3 -m venv --system-site-packages /opt/venv-st \
 && /opt/venv-st/bin/pip install --no-cache-dir \
      "sentence-transformers==5.1.0" \
      "transformers==4.55.4" \
      "pyarrow==25.0.1" \
      einops

ENV PYTHONPATH=/srv HF_HOME=/hf
WORKDIR /srv
ENTRYPOINT ["/opt/venv-st/bin/python"]
