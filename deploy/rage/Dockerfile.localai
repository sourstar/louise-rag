# syntax=docker/dockerfile:1
# RAGE over LocalAI — migration step 15e (docs/notes/rage-over-localai.md).
# LocalAI launches, loads and evicts the models; RAGE's front states the run
# of every answer. RAGE's only image since 15g: deploy/rage/Dockerfile, the
# llama-swap one this file cites below, was retired then (its text is in git).
#
#   docker build -f deploy/rage/Dockerfile.localai \
#     --build-arg LLAMA_CPP_IMAGE=ghcr.io/ggml-org/llama.cpp@sha256:<digest of server-intel-b10630> \
#     -t <registry>/rage:<build> .
#   docker push <registry>/rage:<build>      # then deploy BY DIGEST, never by this tag
#
# EVERYTHING IS PINNED BY DIGEST OR BY COMMIT. LocalAI is built from the
# commit `deploy/localai/patches/series` names, with every patch of the
# series applied (P1, `load_options` in GET /system, without which no run can
# be stated); the SYCL llama.cpp backend is the image LocalAI's own CI built
# from that same commit. A build that does not say which bytes it expects
# does not get any (as deploy/rage/Dockerfile's llama-swap checksum).

# The build images, by digest (Docker Hub, 2026-10-03): Go 1.26.0, which
# LocalAI's go.mod asks for, and the Node its own Dockerfile builds the web
# UI with.
ARG GO_IMAGE=golang:1.26.0-bookworm@sha256:2a0ba12e116687098780d3ce700f9ce3cb340783779646aafbabed748fa6677c
ARG NODE_IMAGE=node:26-slim@sha256:ec7758ee051e457b468b32bde57b0879010b325bb9862718e9615225ce4aaae1
ARG BUSYBOX_IMAGE=busybox:1.37.0-uclibc@sha256:31b72538c3019a20336b04c4cebcd47c36511d0b45aa76666804c2845055bbd3
# The protoc LocalAI's Makefile downloads (v31.1, its `protoc` target), here
# with the checksum it does not check. Fetched and unzipped in stages of their
# own: the Go image has no unzip, and installing one would need a package
# mirror the build otherwise never touches.
ARG PROTOC_URL=https://github.com/protocolbuffers/protobuf/releases/download/v31.1/protoc-31.1-linux-x86_64.zip
ARG PROTOC_SHA256=96553041f1a91ea0efee963cb16f462f5985b4d65365f3907414c360044d8065
# LocalAI's SYCL f16 llama.cpp backend built from the series' base commit:
# `localai/localai-backends:sha-58830f7-gpu-intel-sycl-f16-llama-cpp`, also
# tagged v4.11.0 (Docker Hub, 2026-10-03; 0.27 GiB). A FROM-scratch image of
# the backend's files, copied whole into the system backends path.
ARG LLAMA_CPP_BACKEND_IMAGE=localai/localai-backends@sha256:eb0c909e0e405c6a8111472f829e060955431fa47be97afd25adb178d538cd68
# For the `smoke` target only (below): LocalAI's CPU llama.cpp backend from
# the same commit (`sha-58830f7-cpu-llama-cpp`, 48 MiB), and a Python base.
ARG LLAMA_CPP_CPU_BACKEND_IMAGE=localai/localai-backends@sha256:fe237fef5dccd0e177dcdc53b0064354efbbc29b10cd5fbe3d40a7d73a98965a
ARG PYTHON_IMAGE=python:3.12-slim-bookworm@sha256:54c85f3c47607a77f32adec749d3c81d1348bf25833671f512b26a9b6d778cb3
# The platform's Python backends (migration step 15e-2): the stub generator, at
# the grpcio of deploy/localai/backends/requirements-grpc.txt, and the one torch
# — the version deploy/rage/Dockerfile built and imported (2.14.0+xpu), here
# pinned rather than whatever the index serves that day.
ARG GRPCIO_TOOLS_VERSION=1.84.0
ARG TORCH_VERSION=2.14.0
# The base, as deploy/rage/Dockerfile's: the Intel llama.cpp image whose
# Level Zero / OpenCL runtime drives the Arc Pro B70. No default: pass the
# digest, as there.
ARG LLAMA_CPP_IMAGE

# ---- LocalAI's source: the base commit and the series ---------------------------------
FROM ${GO_IMAGE} AS localai-source
COPY deploy/localai/patches /patches
RUN set -eu; \
    base="$(sed -n 's/^base //p' /patches/series)"; \
    test -n "$base"; \
    git init -q /build && cd /build \
 && git remote add origin https://github.com/mudler/LocalAI \
 && git fetch -q --depth 1 origin "$base" && git checkout -q FETCH_HEAD \
 && test "$(git rev-parse HEAD)" = "$base" \
 && for p in $(grep -v -e '^#' -e '^base ' -e '^$' /patches/series); do \
      git apply --index "/patches/$p" && echo "applied $p"; \
    done \
 && echo "${base}" > /build/.rage-base

# ---- protoc, by checksum ------------------------------------------------------------------------
FROM ${GO_IMAGE} AS protoc-zip
ARG PROTOC_URL
ARG PROTOC_SHA256
RUN curl -fsSL -o /protoc.zip "${PROTOC_URL}" \
 && echo "${PROTOC_SHA256}  /protoc.zip" | sha256sum -c -

FROM ${BUSYBOX_IMAGE} AS protoc
COPY --from=protoc-zip /protoc.zip /protoc.zip
RUN mkdir /out && unzip -q /protoc.zip bin/protoc -d /out && /out/bin/protoc --version

# ---- its web UI, as LocalAI's own Dockerfile builds it ------------------------------------
FROM ${NODE_IMAGE} AS localai-ui
WORKDIR /app
COPY --from=localai-source /build/core/http/react-ui/ ./
RUN npm ci && npm run build

# ---- the binary ---------------------------------------------------------------------------------
# Its version names the base and the series' bytes: `local-ai` answers it at
# GET /version, and RAGE writes it as the engine's readable `build`. Taken
# from git, it would carry the commit `git am` makes, whose hash moves with
# the build's clock.
FROM localai-source AS localai-build
COPY --from=localai-ui /app/dist /build/core/http/react-ui/dist
# where the Makefile's `protoc` target would put it, so that target is done
COPY --from=protoc /out/bin/protoc /build/protoc
RUN set -eu; cd /build; \
    version="$(cut -c1-7 .rage-base)+patches.$(cat /patches/series /patches/*.patch | sha256sum | cut -c1-12)"; \
    make protogen-go \
 && make build VERSION="$version" GO_TAGS=auth \
 && ./local-ai --help >/dev/null \
 && install -D local-ai /out/local-ai && echo "$version" > /out/version

FROM ${LLAMA_CPP_BACKEND_IMAGE} AS llama-cpp-backend
FROM ${LLAMA_CPP_CPU_BACKEND_IMAGE} AS llama-cpp-cpu-backend

# ---- the platform's Python models as LocalAI backends, without their venvs ---------------------
# deploy/localai/backends (15e-2): in each backend's directory its backend.py,
# the server it wraps under the name it imports, louise_backend.py, run.sh, the
# gRPC stubs generated here from the series' own backend.proto, and LocalAI's
# interceptors from the same commit (`grpc_auth`: the model-identity check, its
# token, the watcher that ends a backend whose LocalAI died). The venvs are
# made in the image, against its python and its torch.
FROM ${PYTHON_IMAGE} AS louise-backends
ARG GRPCIO_TOOLS_VERSION
COPY deploy/localai/backends/requirements-grpc.txt /src/requirements-grpc.txt
RUN pip install --no-cache-dir -q "grpcio-tools==${GRPCIO_TOOLS_VERSION}" -r /src/requirements-grpc.txt
COPY --from=localai-source /build/backend/backend.proto /proto/backend.proto
COPY --from=localai-source /build/backend/python/common/grpc_auth.py \
     /build/backend/python/common/model_identity.py \
     /build/backend/python/common/parent_watch.py /common/
COPY deploy/localai/backends /src
COPY deploy/madlad-translate/server.py /src/louise-madlad/madlad.py
COPY deploy/medcpt-rerank/server.py    /src/louise-medcpt-rerank/medcpt.py
COPY deploy/dar-legal-it/server.py     /src/louise-dar-legal-it/dar_legal_it.py
RUN set -eu; mkdir /stubs /out; \
    python -m grpc_tools.protoc -I/proto --python_out=/stubs --grpc_python_out=/stubs backend.proto; \
    cp /src/requirements-grpc.txt /out/; \
    for d in /src/louise-*; do \
      name="$(basename "$d")"; out="/out/$name"; mkdir "$out"; \
      cp "$d"/*.py "$d"/requirements.txt /src/run.sh /src/louise_backend.py /stubs/*.py /common/*.py "$out"/; \
      chmod 0755 "$out/run.sh"; \
      printf '{"name": "%s"}\n' "$name" > "$out/metadata.json"; \
      (cd "$out" && python -c "import backend_pb2, backend_pb2_grpc, grpc_auth, louise_backend"); \
    done; \
    find /out -name __pycache__ -type d -prune -exec rm -rf {} +; \
    ls /out

# ---- `smoke`: RAGE over this LocalAI on any CPU, never published ------------------------------
# The same LocalAI and front, the CPU backend of the same commit, no card. It
# proves the chain on a machine without the B70 — `docker build --target
# smoke`, then a tiny model (tools/rage_smoke_model.py) PUT and asked
# (docs/notes/rage-over-localai.md §11 has the recipe and what it found).
FROM ${PYTHON_IMAGE} AS smoke
COPY --from=localai-build /out/local-ai /usr/bin/local-ai
COPY --from=localai-build /out/version  /etc/rage/localai-version
COPY --from=llama-cpp-cpu-backend / /var/lib/local-ai/backends/llama-cpp/
# and one Python backend, MedCPT's on OpenVINO's CPU (no torch, which only the
# node's image carries): LocalAI spawning a Louise backend from the system
# path, its gRPC, and a run stated for it (rage-over-localai §11)
COPY --from=louise-backends /out/requirements-grpc.txt /var/lib/local-ai/backends/
COPY --from=louise-backends /out/louise-medcpt-rerank /var/lib/local-ai/backends/louise-medcpt-rerank/
RUN printf '%s\n' '{"name": "llama-cpp"}' > /var/lib/local-ai/backends/llama-cpp/metadata.json \
 && cd /var/lib/local-ai/backends && python3 -m venv louise-medcpt-rerank/venv \
 && louise-medcpt-rerank/venv/bin/pip install --no-cache-dir -q -r louise-medcpt-rerank/requirements.txt \
 && (cd louise-medcpt-rerank && venv/bin/python -c "import backend") \
 && python3 -m venv /opt/venv-front \
 && /opt/venv-front/bin/pip install --no-cache-dir -q \
      "fastapi>=0.115" "uvicorn[standard]>=0.30" "httpx>=0.27"
COPY app/__init__.py       /srv/app/__init__.py
COPY app/gpu_clock.py      /srv/app/gpu_clock.py
COPY app/gpu_memory.py     /srv/app/gpu_memory.py
COPY app/hold/__init__.py  /srv/app/hold/__init__.py
COPY app/hold/codex.py     /srv/app/hold/codex.py
COPY app/rage              /srv/app/rage
WORKDIR /srv
ENV PYTHONPATH=/srv RAGE_RUNNER=localai RAGE_CONFIG=/config/rage.toml RAGE_STATE_DIR=/state \
    RAGE_PORT=8080 LOCALAI_BIN=/usr/bin/local-ai LOCALAI_MODELS_DIR=/state/localai-models \
    LOCALAI_BACKENDS_SYSTEM_PATH=/var/lib/local-ai/backends \
    LOCALAI_BACKENDS_PATH=/state/localai-backends \
    LOCALAI_GALLERIES='[]' LOCALAI_BACKEND_GALLERIES='[]' \
    LOCALAI_AUTOLOAD_GALLERIES=false LOCALAI_AUTOLOAD_BACKEND_GALLERIES=false
ENTRYPOINT ["/opt/venv-front/bin/python", "-m", "app.rage"]

# ---- the image ------------------------------------------------------------------------------------
FROM ${LLAMA_CPP_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 python3-venv python3-pip ca-certificates curl \
 && rm -rf /var/lib/apt/lists/*

# What the run identity calls the compute runtime (09 §9.12, `driver`), as in
# deploy/rage/Dockerfile: read back at start, no package manager runs then.
RUN mkdir -p /etc/rage \
 && dpkg-query -W -f='${Package} ${Version}\n' libze-intel-gpu1 intel-opencl-icd libze1 \
      > /etc/rage/runtime-versions \
 && cat /etc/rage/runtime-versions

# LocalAI, and its backends in the SYSTEM path: part of the image, read-only,
# and the only backends there are (09 §9.12: "an engine the runner installed
# after the image was built ... states no run" — app/rage/observer.py refuses
# a process whose program lies outside this path).
COPY --from=localai-build /out/local-ai /usr/bin/local-ai
COPY --from=localai-build /out/version  /etc/rage/localai-version
COPY --from=llama-cpp-backend / /var/lib/local-ai/backends/llama-cpp/
RUN printf '%s\n' '{"name": "llama-cpp", "uri": "localai/localai-backends:sha-58830f7-gpu-intel-sycl-f16-llama-cpp"}' \
      > /var/lib/local-ai/backends/llama-cpp/metadata.json \
 && test -x /var/lib/local-ai/backends/llama-cpp/run.sh

# The platform's three Python models beside it (15e-2): DAR-legal-it
# (`Embedding`), MedCPT (`Rerank`) and MADLAD (`Predict`); DNABERT-2 is frozen
# and not served. ONE TORCH, as in deploy/rage/Dockerfile: it is tied to the
# compute runtime, so the two torch backends see the system's through
# --system-site-packages, each venv keeping the pins it was proven with
# (requirements.txt), and each backend's lib/ puts torch's SYCL runtime before
# the base's older oneAPI loader (run.sh). PROOF, still, as there: that torch
# sees the card through this base's Level Zero loader (15c, on the node).
ARG TORCH_VERSION
RUN pip3 install --no-cache-dir --break-system-packages "torch==${TORCH_VERSION}" \
      --index-url https://download.pytorch.org/whl/xpu
COPY --from=louise-backends /out/ /var/lib/local-ai/backends/
RUN set -eu; cd /var/lib/local-ai/backends; \
    python3 -m venv --system-site-packages louise-madlad/venv; \
    python3 -m venv --system-site-packages louise-dar-legal-it/venv; \
    python3 -m venv louise-medcpt-rerank/venv; \
    ln -s /usr/local/lib louise-madlad/lib; \
    ln -s /usr/local/lib louise-dar-legal-it/lib; \
    for b in louise-madlad louise-dar-legal-it louise-medcpt-rerank; do \
      "$b/venv/bin/pip" install --no-cache-dir -r "$b/requirements.txt"; \
      (cd "$b" && LD_LIBRARY_PATH="$PWD/lib" venv/bin/python -c "import backend"); \
    done; \
    LD_LIBRARY_PATH=/usr/local/lib louise-madlad/venv/bin/python -c "import torch, transformers; print(torch.__version__, transformers.__version__)"; \
    LD_LIBRARY_PATH=/usr/local/lib louise-dar-legal-it/venv/bin/python -c "import torch, sentence_transformers; print(sentence_transformers.__version__)"; \
    louise-medcpt-rerank/venv/bin/python -c "import openvino, tokenizers; print(openvino.__version__)"

# The front: app/rage and the two modules it borrows — the clock, and the ONE
# definition of canonical JSON and of the hash (as deploy/rage/Dockerfile).
RUN python3 -m venv /opt/venv-front \
 && /opt/venv-front/bin/pip install --no-cache-dir \
      "fastapi>=0.115" "uvicorn[standard]>=0.30" "httpx>=0.27"
COPY app/__init__.py       /srv/app/__init__.py
COPY app/gpu_clock.py      /srv/app/gpu_clock.py
COPY app/gpu_memory.py     /srv/app/gpu_memory.py
COPY app/hold/__init__.py  /srv/app/hold/__init__.py
COPY app/hold/codex.py     /srv/app/hold/codex.py
COPY app/rage              /srv/app/rage

WORKDIR /srv
# LocalAI's galleries are OFF: nothing is installed after the image is built.
# Its key is never set: it listens on loopback and RAGE's front is the door
# (rage-over-localai §8.4; app/rage/__main__.py strips one if given). The §10
# switches are forced by the front on the LocalAI it starts, whatever is set.
ENV PYTHONPATH=/srv RAGE_RUNNER=localai RAGE_CONFIG=/config/rage.toml RAGE_STATE_DIR=/state \
    RAGE_PORT=8080 LOCALAI_BIN=/usr/bin/local-ai LOCALAI_MODELS_DIR=/state/localai-models \
    LOCALAI_BACKENDS_SYSTEM_PATH=/var/lib/local-ai/backends \
    LOCALAI_BACKENDS_PATH=/state/localai-backends \
    LOCALAI_GALLERIES='[]' LOCALAI_BACKEND_GALLERIES='[]' \
    LOCALAI_AUTOLOAD_GALLERIES=false LOCALAI_AUTOLOAD_BACKEND_GALLERIES=false
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s \
  CMD /opt/venv-front/bin/python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/health', timeout=4)"
# RAGE_IMAGE is NOT set here: the image cannot know its own digest. The
# deployment sets it, to the digest it pins (app/rage/runs.py, boot_image).
ENTRYPOINT ["/opt/venv-front/bin/python", "-m", "app.rage"]
