{
  "id": "localai@qwen3.5-9b",
  "variant": "qwen3.5-9b",
  "name": "louise-chat-qwen3.5-9b-q4",
  "overrides": {
    "backend": "vega-louise-llama-cpp",
    "context_size": 16384,
    "env": {
      "GGML_SYCL_ENABLE_DNN": "0",
      "GGML_SYCL_FA_ONEDNN": "0",
      "NEO_CACHE_DIR": "/data/louise-cache/neo-cache"
    },
    "flash_attention": "on",
    "gpu_layers": 999,
    "mmap": true,
    "mmproj": "",
    "known_usecases": [
      "chat"
    ],
    "options": [
      "use_jinja:true",
      "parallel:1",
      "cache_ram:0",
      "ubatch:512"
    ],
    "parameters": {
      "seed": 0,
      "batch": 2048,
      "temperature": 0.7,
      "top_p": 0.8,
      "top_k": 20,
      "min_p": 0,
      "presence_penalty": 1.5,
      "repeat_penalty": 1
    },
    "reasoning_effort": "none",
    "chat_template_kwargs": {
      "enable_thinking": false
    },
    "threads": 6
  }
}
