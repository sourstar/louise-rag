# Node-level Tier-2 configuration (architecture-v2.md §5.2, §14).
#
# Copy to ${CONFIG_DIR:-.}/platform.toml to activate. WITHOUT this file the
# budget is unlimited and the schedule is always-full, i.e. exactly the
# behavior of a deployment that predates the transfer manager — so adopting
# it is opt-in and reversible by deleting the file.
#
# This is desired state: versioned, diffable, backupable. It belongs in git
# next to collections/*.toml. Runtime overrides ("boost bandwidth tonight")
# are Tier 3, live in the control table, carry an expiry, and never get
# written back here (CLAUDE.md invariant 10).

[bandwidth]
# Accepted units: bit/kbit/Mbit/Gbit (SI, /8 to bytes), B/KB/MB/GB (SI),
# KiB/MiB/GiB (binary). A bare number is bytes/second.
# Recommended: ~80% of your MEASURED uplink. The uplink is the scarce
# resource on an asymmetric line — saturating it wrecks the downlink too via
# ACK starvation and bufferbloat.
down_max = "400Mbit"
up_max = "40Mbit"

# Headroom only interactive traffic may draw on, so a query burst preempts a
# running backfill without waiting for its in-flight chunk to drain.
reserve_interactive = "20%"

# Cron-style windows; first match wins, "else" covers the rest of the day.
# Windows may wrap midnight ("22:00-06:00 full"). Factors: full | off | N%.
# Wall-clock local time, so DST shifts them as an operator would expect.
schedule = "01:00-07:00 full; else 30%"

[trust]
# Pubkeys whose SIGNED space artifacts are fully trusted — their calibrated
# tolerances apply as measured. Anyone else's artifact loads as ADVISORY: it
# may tighten verification but can never loosen a tolerance below the built-in
# coarse floor. Deliberately not trust-on-first-use: an artifact defines what
# "honest vectors" means, so trusting one on sight would hand an attacker the
# definition. (Producer keys for BUNDLES are separate and are trusted on first
# use per collection, in its `providers` table.)
# space_authors = ["<64-hex ed25519 pubkey>"]

[transfer]
# Global fetch workers across all endpoints.
workers = 8
# Per-endpoint ceiling. The effective limit is the minimum of this,
# Endpoint.max_conns and the spec's RateLimit.max_conns — parallelism never
# overrides origin etiquette.
per_endpoint = 4
# Multi-connection downloads of a SINGLE file: N concurrent Range requests
# for disjoint slices, written straight into their final offsets.
#
# Default 1, deliberately (§5.2: "default-off against origins"). It buys
# nothing on a link the origin can already saturate — it helps when a single
# stream is capped well below your line, which is a per-mirror property, not
# a general one. Every extra socket is a cost the origin pays.
#
# Three ceilings apply whatever you write here: this number, the endpoint's
# own allowance (per_endpoint / Endpoint.max_conns / the source's
# RateLimit.max_conns), and a 32 MB size floor below which files are never
# split. Values above 8 are refused — past a handful of connections one
# client stops being a polite peer.
#
# Interrupted segmented downloads resume per segment via a small
# `<file>.segments.json` sidecar beside the .part file; an origin that
# ignores Range falls back to a single stream automatically.
segments_per_file = 1

# ---------------------------------------------------------------------------
# Per-PLUGIN default embedding recipe. A collection created without its own
# [embed] block inherits the entry for its plugin; with no entry it falls
# back to the Tier-1 env recipe. Resolution order, each step a fallback for
# the one before it and never an override of it:
#
#     collection TOML [embed]  ->  [embed_defaults.<plugin>]  ->  env
#
# This exists because the env recipe is the node's TEXT encoder, and not
# every plugin embeds text. A genome collection embedded with a language
# model is not a worse choice, it is a wrong one: DNA is not a language and
# the two spaces are not comparable. Two genome collections were created
# against the node default and pinned a text space over DNA before anyone
# noticed.
#
# Fields are exactly a collection's [embed] block. The endpoint URL is
# deployment-specific, which is why this lives in your node's config and not
# in the repo.
#
# [embed_defaults.genome]
# url = "http://<your-dna-encoder-host>:<port>"
# api = "openai"
# model = "zhihan1996/DNABERT-2-117M"
# dtype = "f16"
# ctx = 1024
# dim = 768
# concurrency = 2
# device = "cpu"

# [deposit] — what a deposit collection is created with when the creator names
# nothing (02 §2.9, 07 §7.8): LocalAGI's routes create collections and carry no
# model. `encoder` is the endpoint; the first deposit collection on it is given
# its space block once (`space`, a file beside this one, or `space_from`, a Codex
# to copy it from); every later one copies that collection's space.
# The reference node (operator, 2026-10-06): granite-embedding-107m-multilingual
# on RAGE, LocalAGI's own default, and the space file the deposit runbook wrote
# from the run RAGE stated.
# `encoder` is the SERVER; `api` (openai by default, ollama, vega) and the
# models complete the [encoder] block the new collection's file is written with
# (amended 2026-10-09). Absent, the model is the one a `…/upstream/<model>` URL
# names, else the create is refused; with api = "vega" both are required.
# [deposit]
# encoder = "http://192.168.178.10:30437/upstream/granite-embedding-107m-multilingual"
# space = "deposit-space.toml"
# On LocalAI (one address, every model):
# encoder = "http://192.168.178.10:30286"
# api = "vega"
# embed_model = "vega-granite"
# query_model = "vega-granite"

[certifier]
# 07 §7.8; 09 §9.11: what this node says of ITS OWN key in the anchor document
# it serves at /.well-known/louise-certifier.json — a certified collection
# whose Codex names this node's key as certifier is anchored only where a
# domain the operator controls fronts the node with TLS (03 §3.7).
# valid_from = "2026-10-07T00:00:00Z"   # from when the key certifies
# revoked_at = "2027-01-01T00:00:00Z"   # the operator's act, if ever
